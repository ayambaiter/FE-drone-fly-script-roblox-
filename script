local function toggleDroneMode(forcedState)
	if forcedState ~= nil then IS_DRONE_MODE = forcedState else IS_DRONE_MODE = not IS_DRONE_MODE end
	
	if IS_DRONE_MODE then
		-- Save the user's original game FOV before overriding it
		originalGameFov = camera.FieldOfView

		mainButton.Text = "DISABLE DRONE"
		dollContainer.Visible = true; modeLabel.Visible = true; telemetryPanel.Visible = true; hudToggleButton.Visible = true
		updateModeUI()
		updatePaperDollModel()
		
		if not HAS_SAID_HELLO then
			HAS_SAID_HELLO = true
			task.spawn(function()
				task.wait(0.8)
				if not IS_DRONE_MODE then return end
				
				local speechBubble = Instance.new("Frame")
				speechBubble.Size = UDim2.new(0, 70, 0, 26)

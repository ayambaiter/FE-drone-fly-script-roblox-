local isDraggingSlider = false
fovSliderBg.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDraggingSlider = true
		telemetryPanel.Draggable = false 
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		if isDraggingSlider then
			isDraggingSlider = false
			telemetryPanel.Draggable = true 
		end
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if isDraggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local mouseX = UserInputService:GetMouseLocation().X
		local sliderX = fovSliderBg.AbsolutePosition.X
		local sliderWidth = fovSliderBg.AbsoluteSize.X
		local pct = math.clamp((mouseX - sliderX) / sliderWidth, 0, 1)
		baseFov = math.floor(30 + (pct * 90)) 
		fovSliderFill.Size = UDim2.new(pct, 0, 1, 0)
		fovInputBox.Text = tostring(baseFov)
	end
end)

fovInputBox.Focused:Connect(function()
	telemetryPanel.Draggable = false 
end)

fovInputBox.FocusLost:Connect(function()
	telemetryPanel.Draggable = true 
	local parsedVal = tonumber(fovInputBox.Text)
	if parsedVal then
		baseFov = math.clamp(math.floor(parsedVal), 30, 120)
	end
	fovInputBox.Text = tostring(baseFov)
	local pct = (baseFov - 30) / 90
	fovSliderFill.Size = UDim2.new(pct, 0, 1, 0)
end)


-- --- DRONE PHYSICS ENGINE ---
local function updateDrone(rawDt)
    -- BULLETPROOF FAILSAFES: Forces variables to default if they report as nil
    local dt = (type(rawDt) == "number") and rawDt or 0.016
    local safeSens = (type(CAMERA_STICK_SENSITIVITY) == "number") and CAMERA_STICK_SENSITIVITY or 2.5
    local safeTurn = (type(TURN_SPEED) == "number") and TURN_SPEED or 4.5
    local safePitchSpd = (type(KEYBOARD_PITCH_SPEED) == "number") and KEYBOARD_PITCH_SPEED or 2.2

	if not IS_DRONE_MODE or not rootPart or not head or not character:FindFirstChild("Humanoid") then return end
	if humanoid.Health <= 0 then return end 
	if humanoid.Sit then humanoid.Sit = false end

	if clonedModel and clonedModel.PrimaryPart then
		local _, yawAngle, _ = droneHeadingCFrame:ToEulerAnglesYXZ()
		clonedModel:SetPrimaryPartCFrame(CFrame.new(0, 0, 0) * CFrame.Angles(currentTiltX, yawAngle + math.rad(145), currentTiltZ))
	end

	for _, child in pairs(character:GetDescendants()) do
		if child:IsA("BasePart") then
			child.LocalTransparencyModifier = 1
			child.CanCollide = not IS_NOCLIP_MODE
		end
	end

	local isTyping = UserInputService:GetFocusedTextBox() ~= nil

	-- --- CAMERA INPUT SYSTEM ENGINE ---
	local lookInputY = 0
	local gamepadYawInput = 0
	
	if not isTyping then
		local mouseDelta = UserInputService:GetMouseDelta()
		cameraPitch = cameraPitch - (mouseDelta.Y * 0.003)
		cameraYaw = cameraYaw - (mouseDelta.X * 0.003) 
		
		if UserInputService:IsKeyDown(Enum.KeyCode.Up) then cameraPitch = cameraPitch + (safePitchSpd * dt) end
		if UserInputService:IsKeyDown(Enum.KeyCode.Down) then cameraPitch = cameraPitch - (safePitchSpd * dt) end
		if UserInputService:IsKeyDown(Enum.KeyCode.Left) then cameraYaw = cameraYaw + (safeTurn * 0.4 * dt) end
		if UserInputService:IsKeyDown(Enum.KeyCode.Right) then cameraYaw = cameraYaw - (safeTurn * 0.4 * dt) end
	end

	-- --- FLIGHT INPUT SYSTEM MAP ---
	local moveInputX = 0 
	local moveInputZ = 0 
	local verticalInputY = 0 
	
	local isHoldingAccel = false
	local isHoldingDecel = false
	local rawThrottleDelta = 0
	
	if not isTyping then
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveInputZ = moveInputZ + 1 end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveInputZ = moveInputZ - 1 end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveInputX = moveInputX + 1 end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveInputX = moveInputX - 1 end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then verticalInputY = verticalInputY + 1 end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then verticalInputY = verticalInputY - 1 end
		
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then 
			isHoldingAccel = true
			rawThrottleDelta = rawThrottleDelta + 1 
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) then 
			isHoldingDecel = true
			rawThrottleDelta = rawThrottleDelta - 1 
		end
	end

	-- --- GAMEPAD POLLING MATRIX ---
	if UserInputService:GetGamepadConnected(Enum.UserInputType.Gamepad1) then
		local gamepadState = UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1)
		for _, input in pairs(gamepadState) do
			if input.KeyCode == Enum.KeyCode.Thumbstick2 then
				lookInputY = applyDeadzone(input.Position.Y, 0.15)
				gamepadYawInput = applyDeadzone(input.Position.X, 0.15) * -1
			elseif input.KeyCode == Enum.KeyCode.Thumbstick1 then
				moveInputX = moveInputX + applyDeadzone(input.Position.X, 0.15)
				moveInputZ = moveInputZ + applyDeadzone(input.Position.Y, 0.15)
			
			elseif input.KeyCode == Enum.KeyCode.ButtonR2 then
				if input.Position.Z > 0.15 then 
					isHoldingAccel = true
					rawThrottleDelta = rawThrottleDelta + input.Position.Z
				end
			elseif input.KeyCode == Enum.KeyCode.ButtonL2 then
				if input.Position.Z > 0.15 then 
					isHoldingDecel = true
					rawThrottleDelta = rawThrottleDelta - input.Position.Z
				end
				
			elseif input.KeyCode == KEYBIND_NOCLIP_GAMEPAD and input.Position.Z == 1 then
				local now = os.clock()
				if now - lastGamepadNoclipPress > 0.4 then 
					lastGamepadNoclipPress = now; IS_NOCLIP_MODE = not IS_NOCLIP_MODE
				end
			elseif input.KeyCode == KEYBIND_ACRO_GAMEPAD and input.Position.Z == 1 then
				local now = os.clock()
				if now - lastGamepadAcroPress > 0.4 then
					lastGamepadAcroPress = now; IS_ACRO_MODE = not IS_ACRO_MODE; updateModeUI()
				end
			end
		end
		
		if UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonR1) then 
			verticalInputY = 1
		elseif UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonL1) then 
			verticalInputY = -1 
		end
	end
	
    local safeLookY = (type(lookInputY) == "number") and lookInputY or 0
    local safeGamepadYaw = (type(gamepadYawInput) == "number") and gamepadYawInput or 0

	cameraYaw = cameraYaw + (safeGamepadYaw * safeTurn * dt)
	
	if not IS_ACRO_MODE then
		cameraPitch = math.clamp(cameraPitch + (safeLookY * safeSens * dt), math.rad(-75), math.rad(75))
	else
		cameraPitch = cameraPitch + (safeLookY * safeSens * dt)
	end

	local yawDelta = math.abs(cameraYaw - previousCameraYaw)
	previousCameraYaw = cameraYaw

	droneHeadingCFrame = CFrame.Angles(0, cameraYaw, 0)

	-- --- AUTOMATIC FLIGHT-MODE ENGINE MATRIX ---
	local targetAccel = BASE_ACCEL
	local targetMaxSpeed = BASE_MAX_HORIZ
	local speedScaleFactor = 1

	if IS_ACRO_MODE then
		fpvThrottle = math.clamp(fpvThrottle + (rawThrottleDelta * THROTTLE_SPEED * dt), 0, 1)
		targetAccel = ACRO_ACCEL
		targetMaxSpeed = ACRO_MAX_SPEED
		speedScaleFactor = 1
	else
		if isHoldingAccel then
			targetAccel = BOOST_ACCEL
			targetMaxSpeed = BOOST_MAX_HORIZ
			speedScaleFactor = ACCEL_MULTIPLIER
		elseif isHoldingDecel then
			targetAccel = BASE_ACCEL
			targetMaxSpeed = BASE_MAX_HORIZ * DECEL_MULTIPLIER
			speedScaleFactor = DECEL_MULTIPLIER
		else
			targetAccel = BASE_ACCEL
			targetMaxSpeed = BASE_MAX_HORIZ
		end
	end

	currentEngineAccel = currentEngineAccel + (targetAccel - currentEngineAccel) * ACCEL_TRANSITION_SPEED * dt
	currentEngineMaxSpeed = currentEngineMaxSpeed + (targetMaxSpeed - currentEngineMaxSpeed) * ACCEL_TRANSITION_SPEED * dt

	local activeCamRotation = CFrame.Angles(0, cameraYaw, 0) * CFrame.Angles(cameraPitch, 0, 0)
	local movementForceVector = Vector3.new()
	local activeFrictionMultiplier = 1

	if IS_ACRO_MODE then
		isLockingStandby = false
		local forwardVector = activeCamRotation.LookVector
		local rightVector = activeCamRotation.RightVector
		local upVector = activeCamRotation.UpVector
		
		local dynamicThrustAngle = (forwardVector * 0.85 + upVector * 0.15).Unit
		
		movementForceVector = (dynamicThrustAngle * fpvThrottle) + (rightVector * moveInputX * 0.5) + (upVector * (verticalInputY * 0.3))
		currentVelocity = currentVelocity + (movementForceVector * currentEngineAccel * dt)
		
		local currentAcroDrag = ACRO_AERO_DRAG
		if fpvThrottle <= 0.1 and currentVelocity.Y < -15 then
			currentAcroDrag = ACRO_STALL_DRAG
		end
		
		local turnFriction = 1 - math.clamp(yawDelta * ACRO_TURN_BLEED, 0, 0.10) 
		activeFrictionMultiplier = turnFriction * math.pow(currentAcroDrag, dt * 60)
		
		currentVelocity = currentVelocity * activeFrictionMultiplier
	else
		local flatForward = droneHeadingCFrame.LookVector
		local flatRight = droneHeadingCFrame.RightVector
		movementForceVector = (flatForward * moveInputZ * speedScaleFactor) + (flatRight * moveInputX * speedScaleFactor)
		
		if verticalInputY ~= 0 then
			isLockingStandby = false
		else
			if not isLockingStandby and math.abs(currentVelocity.Y) < 4 then
				standbyAltitude = rootPart.Position.Y; isLockingStandby = true
			end
		end
		
		local accelX = movementForceVector.X * currentEngineAccel
		local accelY = verticalInputY * (currentEngineAccel * 1.2)
		local accelZ = movementForceVector.Z * currentEngineAccel
		currentVelocity = currentVelocity + Vector3.new(accelX * dt, accelY * dt, accelZ * dt)
		
		local horizVel = Vector3.new(currentVelocity.X, 0, currentVelocity.Z) * math.pow(HORIZONTAL_DRAG, dt * 60)
		local vertVelY = currentVelocity.Y * math.pow(VERTICAL_DRAG, dt * 60)
		currentVelocity = Vector3.new(horizVel.X, vertVelY, horizVel.Z)
	end

	if currentVelocity.Magnitude > currentEngineMaxSpeed then
		currentVelocity = currentVelocity.Unit * currentEngineMaxSpeed
	end

	-- --- TELEMETRY UI UPDATES ---
	local currentSpeed = math.floor(currentVelocity.Magnitude)
	speedLabel.Text = "SPEED: " .. tostring(currentSpeed) .. " SPS"
	
	if IS_ACRO_MODE then
		throttleLabel.Text = "THROTTLE: " .. tostring(math.floor(fpvThrottle * 100)) .. "%"
		local resistancePercentage = 100 - (activeFrictionMultiplier * 100)
		dragLabel.Text = "RESISTANCE: " .. string.format("%.1f", resistancePercentage) .. "%"
	end

	local calculatedPosition = rootPart.Position + (currentVelocity * dt)
	
	if isLockingStandby and not IS_ACRO_MODE then
		calculatedPosition = Vector3.new(calculatedPosition.X, standbyAltitude, calculatedPosition.Z)
		currentVelocity = Vector3.new(currentVelocity.X, 0, currentVelocity.Z)
	end

	local targetFlightPitch = -MAX_FLIGHT_PITCH * math.clamp(moveInputZ * speedScaleFactor, -1, 1)
	local targetFlightRoll = -MAX_FLIGHT_ROLL * math.clamp(moveInputX * speedScaleFactor, -1, 1)
	currentTiltX = currentTiltX + (targetFlightPitch - currentTiltX) * TILT_LERP_SPEED * dt
	currentTiltZ = currentTiltZ + (targetFlightRoll - currentTiltZ) * TILT_LERP_SPEED * dt

	rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
	rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
	
	if IS_ACRO_MODE then
		rootPart.CFrame = CFrame.new(calculatedPosition) * activeCamRotation
	else
		rootPart.CFrame = CFrame.new(calculatedPosition) * droneHeadingCFrame.Rotation * CFrame.Angles(currentTiltX, 0, currentTiltZ)
	end

	local idealCamCFrame = CFrame.new(head.Position) * activeCamRotation
	local targetCamPos = cameraTrackingCFrame.Position:Lerp(idealCamCFrame.Position, CAM_POS_LERP_SPEED * dt)
	local targetCamRot = cameraTrackingCFrame.Rotation:Lerp(idealCamCFrame.Rotation, CAM_ROT_LERP_SPEED * dt)
	
	cameraTrackingCFrame = CFrame.new(targetCamPos) * targetCamRot
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = cameraTrackingCFrame
end

-- --- LIFE SYSTEMS MANAGEMENT ---
local function setupCharacterTracking(char)
	character = char; rootPart = char:WaitForChild("HumanoidRootPart"); head = char:WaitForChild("Head"); humanoid = char:WaitForChild("Humanoid")
	
	camera.CameraType = Enum.CameraType.Custom
	if humanoid then camera.CameraSubject = humanoid end

	toggleDroneMode(false)
	if humanoidDiedConnection then humanoidDiedConnection:Disconnect() end
	humanoidDiedConnection = humanoid.Died:Connect(function() 
		toggleDroneMode(false) 
		camera.CameraType = Enum.CameraType.Custom
		if humanoid then camera.CameraSubject = humanoid end
	end)
end

setupCharacterTracking(character)
player.CharacterAdded:Connect(setupCharacterTracking)
mainButton.MouseButton1Click:Connect(function() toggleDroneMode() end)

-- --- KEYBOARD INTERCEPTOR ---
UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
	if input.KeyCode == Enum.KeyCode.ButtonSelect then toggleDroneMode(); return end
	
	if IS_DRONE_MODE and not gameProcessedEvent then
		if input.KeyCode == KEYBIND_NOCLIP_KEYBOARD then
			IS_NOCLIP_MODE = not IS_NOCLIP_MODE
		elseif input.KeyCode == KEYBIND_ACRO_KEYBOARD then
			IS_ACRO_MODE = not IS_ACRO_MODE
			updateModeUI()
		end
	end
end)

RunService.RenderStepped:Connect(updateDrone)

		throttleLabel.Visible = false
		dragLabel.Visible = false
	end
end

local function toggleDroneMode(forcedState)
	if forcedState ~= nil then IS_DRONE_MODE = forcedState else IS_DRONE_MODE = not IS_DRONE_MODE end
	
	if IS_DRONE_MODE then
		mainButton.Text = "DISABLE DRONE"; mainButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
		dollContainer.Visible = true; modeLabel.Visible = true; telemetryPanel.Visible = true; hudToggleButton.Visible = true
		updateModeUI(); updatePaperDollModel()
		
		if humanoid then humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false); humanoid.Sit = false; humanoid.PlatformStand = true end
		
		currentVelocity = Vector3.new(0, 0, 0)
		currentTiltX, currentTiltZ, cameraPitch, cameraYaw = 0, 0, 0, 0
		fpvThrottle = 0
		currentEngineAccel = BASE_ACCEL; currentEngineMaxSpeed = BASE_MAX_HORIZ; IS_NOCLIP_MODE = false
		isLockingStandby = true; standbyAltitude = rootPart.Position.Y
		
		local camLook = camera.CFrame.LookVector
		droneHeadingCFrame = CFrame.lookAt(Vector3.new(), Vector3.new(camLook.X, 0, camLook.Z).Unit)
		cameraYaw = math.atan2(-camLook.X, -camLook.Z)
		previousCameraYaw = cameraYaw
		
		if head then cameraTrackingCFrame = CFrame.new(head.Position) * droneHeadingCFrame.Rotation end
		camera.CameraType = Enum.CameraType.Scriptable; UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	else
		mainButton.Text = "ENABLE DRONE"; mainButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
		dollContainer.Visible = false; modeLabel.Visible = false; telemetryPanel.Visible = false; hudToggleButton.Visible = false
		if humanoid then humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true); humanoid.PlatformStand = false end
		IS_NOCLIP_MODE = false 
		
		camera.CameraType = Enum.CameraType.Custom
		if humanoid then camera.CameraSubject = humanoid end
		
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		isLockingStandby = false
		if character then
			for _, child in pairs(character:GetDescendants()) do
				if child:IsA("BasePart") then child.LocalTransparencyModifier = 0; child.CanCollide = true end
			end
		end
	end
end


local function updatePaperDollModel()
	viewportFrame:ClearAllChildren()
	if clonedModel then clonedModel:Destroy() end
	if not character then return end
	
	local worldModel = Instance.new("WorldModel")
	worldModel.Parent = viewportFrame
	
	character.Archivable = true
	clonedModel = character:Clone()
	character.Archivable = false
	
	for _, obj in pairs(clonedModel:GetDescendants()) do
		if obj:IsA("LocalScript") or obj:IsA("Script") or obj:IsA("Animate") then
			obj:Destroy()
		elseif obj:IsA("BasePart") then
			obj.CanCollide = false
			obj.Anchored = true
		end
	end
	
	local hrp = clonedModel:FindFirstChild("HumanoidRootPart")
	if hrp then
		clonedModel.PrimaryPart = hrp
		clonedModel:SetPrimaryPartCFrame(CFrame.new(0, 0, 0))
		clonedModel.Parent = worldModel
		viewportCamera.CFrame = CFrame.new(Vector3.new(2.2, 0.4, -4.5), Vector3.new(0, -0.2, 0))
		viewportCamera.Focus = CFrame.new(Vector3.new(0, -0.2, 0))
	else
		task.wait(0.5)
		updatePaperDollModel()
	end
end

local function applyDeadzone(value, threshold)
    if type(value) ~= "number" then return 0 end
	if math.abs(value) < threshold then return 0 end
	return value
end


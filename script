				speechBubble.BorderSizePixel = 2
				speechBubble.ZIndex = 10
				
				local speechText = Instance.new("TextLabel")
				speechText.Size = UDim2.new(1, 0, 1, 0)
				speechText.BackgroundTransparency = 1
				speechText.Font = Enum.Font.Code
				speechText.Text = "hello!"
				speechText.TextSize = 14
				speechText.TextColor3 = Color3.fromRGB(0, 0, 0)
				speechText.ZIndex = 11
				speechText.Parent = speechBubble
				
				speechBubble.Parent = dollContainer
				
				task.delay(3, function()
					if speechBubble then speechBubble:Destroy() end
				end)
			end)
		end
		
		if humanoid then humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false); humanoid.Sit = false; humanoid.PlatformStand = true end
		
		currentVelocity = Vector3.new(0, 0, 0)
		currentTiltX, currentTiltZ, cameraPitch, cameraYaw, cameraRoll = 0, 0, 0, 0, 0
		fpvThrottle = 0
		batterySagTimer = 0
		currentStallTime = 0
		currentEngineAccel = BASE_ACCEL
		currentEngineMaxSpeed = BASE_MAX_HORIZ; IS_NOCLIP_MODE = false
		isLockingStandby = true; standbyAltitude = rootPart.Position.Y
		
		local camLook = camera.CFrame.LookVector
		droneHeadingCFrame = CFrame.lookAt(Vector3.new(), Vector3.new(camLook.X, 0, camLook.Z).Unit)
		cameraYaw = math.atan2(-camLook.X, -camLook.Z)
		previousCameraYaw = cameraYaw
		
		if head then cameraTrackingCFrame = CFrame.new(head.Position) * droneHeadingCFrame.Rotation end
		camera.CameraType = Enum.CameraType.Scriptable
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	else
		mainButton.Text = "ENABLE DRONE"
		dollContainer.Visible = false; modeLabel.Visible = false; telemetryPanel.Visible = false
		hudToggleButton.Visible = false; espContainer.Visible = false; stallWarningLabel.Visible = false
		IS_ZOOMED = false; IS_ESP_ACTIVE = false; currentStallTime = 0
		
		if humanoid then humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true); humanoid.PlatformStand = false end
		IS_NOCLIP_MODE = false 
		
		camera.CameraType = Enum.CameraType.Custom
		camera.FieldOfView = originalGameFov -- Restore the exact FOV they had before flying
		
		if humanoid then camera.CameraSubject = humanoid end
		
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		isLockingStandby = false
		if character then
			for _, child in pairs(character:GetDescendants()) do
				if child:IsA("BasePart") or child:IsA("Decal") then 
					child.LocalTransparencyModifier = 0
					if child:IsA("BasePart") then
						child.CanCollide = true 
					end
				end
			end
		end
	end
end

